PORT=3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=node_email_test
DB_USER=root
DB_PASS=

# SMTP: servidor al que Nodemailer le entrega los emails.
# Valores por defecto = Mailpit (desarrollo): SMTP en 1025, bandeja en http://localhost:8025
# Para otros proveedores (Gmail, SendGrid, SES...) ver la sección de email del TUTO.md.
SMTP_HOST=localhost
# Puerto 465 -> SMTP_SECURE=true | puertos 587, 25 y 1025 -> SMTP_SECURE=false
SMTP_PORT=1025
SMTP_SECURE=false
# Vacíos con Mailpit. Con Gmail: tu dirección completa y una contraseña de aplicación.
SMTP_USER=
SMTP_PASS=
# Remitente. Va entre comillas por los espacios y los <>.
# Con un proveedor real debe ser una cuenta o dominio verificado en él.
MAIL_FROM="Mi App <no-reply@miapp.local>"

# URL con la que el USUARIO abre el link del email (en producción, tu dominio público)
# barra final a propósito: la usa un test
APP_BASE_URL=http://localhost:3000/

TOKEN_TTL_HOURS=24
BCRYPT_ROUNDS=4
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MIN=15
